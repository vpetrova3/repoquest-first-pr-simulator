# RepoQuest environment variables
# Copy this file to .env and fill in real values for local development.
# In production, set these as project secrets in Vercel (or your host).
# NEVER commit a real .env file.

# IBM watsonx.ai (required for live LLM-powered missions, PR plan, and summary)
# 1. Create a free IBM Cloud account at https://cloud.ibm.com
# 2. Open watsonx.ai at https://dataplatform.cloud.ibm.com/wx/home
# 3. Create a project; copy the project ID from the project's Manage tab
# 4. Create an IBM Cloud API key at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# Optional: region-specific base URL. Defaults to us-south.
# us-south:   https://us-south.ml.cloud.ibm.com   (default)
# eu-de:      https://eu-de.ml.cloud.ibm.com
# au-syd:     https://au-syd.ml.cloud.ibm.com
# jp-tok:     https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=

# Optional: override the Granite model. Defaults to ibm/granite-3-3-8b-instruct.
# Other options as of May 2026: ibm/granite-4-h-small, ibm/granite-13b-instruct-v2
WATSONX_MODEL_ID=

# Optional: API version pin. Defaults to 2024-05-31.
WATSONX_API_VERSION=

# Optional: GitHub fine-grained read-only token for private repository analysis.
# Public repositories work without a token.
GITHUB_TOKEN=
